# Configuración de APIs de Proxy Residencial para evitar bloqueos en Vercel/Render
# Solo necesitas configurar UNA de estas opciones:

# Opción 1: ScraperAPI (5,000 peticiones gratuitas)
# Regístrate en: https://www.scraperapi.com/
SCRAPER_API_KEY=tu_api_key_aqui

# Opción 2: ZenRows (1,000 créditos gratuitos al mes)
# Regístrate en: https://www.zenrows.com/
ZENROWS_API_KEY=tu_api_key_aqui

# Opción 3: ScrapeOps (Proxy aggregator con capa gratuita)
# Regístrate en: https://scrapeops.io/
SCRAPEOPS_API_KEY=tu_api_key_aqui

# Forzar uso de proxy (automático en Vercel/Render)
USE_PROXY=true

# Puerto del servidor
PORT=3001
